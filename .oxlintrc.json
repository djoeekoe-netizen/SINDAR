{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-unmodified-loop-condition": "off"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- The brain is reached over plain HTTP on this device (127.0.0.1), the LAN or a Tailscale IP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

{
  "name": "@sindar/gateway",
  "version": "0.1.0",
  "description": "SINDAR gateway — local control plane: HTTP + WebSocket API, static web UI, approvals.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }

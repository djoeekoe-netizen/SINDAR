  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sindar/core": "workspace:*",
    "@types/ws": "^8.18.0"
  }
}

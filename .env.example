# ============================================================
#  SINDAR — مفاتيح المزودين (انسخ هذا الملف إلى ~/.sindar/.env)
#  كل المفاتيح اختيارية. اختر مزوداً واحداً مجانياً على الأقل.
# ============================================================

# --- مجاني بطبقة مجانية (سجّل من المتصفح، بدون بطاقة) ---
# GROQ_API_KEY=            # https://console.groq.com/keys
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (نماذج :free)
# MISTRAL_API_KEY=         # https://console.mistral.ai/
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai/
# GITHUB_TOKEN=            # https://github.com/settings/tokens (GitHub Models)

# --- محلي (لا يحتاج مفتاح) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- مدفوع (اختياري) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# --- القنوات (لاحقاً) ---
# TELEGRAM_BOT_TOKEN=

# --- الـ Gateway ---
# SINDAR_GATEWAY_TOKEN=    # يُولَّد تلقائياً إن تُرك فارغاً
